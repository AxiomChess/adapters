{
  "name": "@axiomchess/adapters",
  "version": "1.0.0",
  "private": true,
  "description": "Chess site adapters, PGN normalization, and recorded fixtures for AxiomChess",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sites.manifest.json": "./sites.manifest.json"
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "tsconfig.build.json",
    "sites.manifest.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json --pretty false",
    "lint": "eslint . && tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
